# Auto detect text files and perform LF normalization
* text=auto

# Imagens vão para o Git LFS: o histórico do repositório fica leve e as fotos ficam em armazenamento separado.
public/uploads/*.png filter=lfs diff=lfs merge=lfs -text
public/uploads/*.jpg filter=lfs diff=lfs merge=lfs -text
public/uploads/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/uploads/*.webp filter=lfs diff=lfs merge=lfs -text
public/assets/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/*.jpg filter=lfs diff=lfs merge=lfs -text
